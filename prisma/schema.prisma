generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Node {
  id            String    @id @default(cuid())
  nodeId        BigInt    @unique
  name          String
  shortName     String
  hardwareModel String    @default("T-Echo")
  role          String    @default("CLIENT")
  status        String    @default("online") // online, offline, unknown
  batteryLevel  Int?      // null = данные ещё не получены
  voltage       Float?    // null = данные ещё не получены
  usbPower      Boolean   @default(false) // напряжение > 3.9V = USB питание
  snr           Float     @default(0.0)
  rssi          Int       @default(0)
  latitude      Float?
  longitude     Float?
  altitude      Float?
  speed         Float?    // GPS ground speed (м/с) — Position.groundSpeed / 1000
  heading       Float?    // GPS heading (градусы) — Position.groundTrack / 10000
  satsInView    Int?      // Количество GPS спутников — Position.satsInView
  hdop          Float?    // Horizontal Dilution of Precision — Position.HDOP / 100
  pressure      Float?    // Атмосферное давление (гПа) — EnvironmentMetrics.barometricPressure
  channelUtilization Float? // Загрузка канала % — DeviceMetrics.channelUtilization
  airUtilTx     Float?    // Использование эфира TX % — DeviceMetrics.airUtilTx
  lsSecs        Int?      // Light sleep interval in seconds (for TRACKER/CLIENT roles)
  minWakeSecs   Int?      @default(10) // Minimum awake time in seconds before sleeping
  lastSeen      DateTime  @default(now())
  lastInfoPacket      DateTime?  // Время последнего пакета NODEINFO (порт 4)
  lastTelemetryPacket DateTime?  // Время последнего пакета TELEMETRY (порт 7)
  lastPositionPacket  DateTime?  // Время последнего пакета POSITION (порт 3)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  telemetry     Telemetry[]
}

model Channel {
  id          String   @id @default(cuid())
  index       Int      @default(0)
  name        String
  psk         String
  uplink      Boolean  @default(true)
  downlink    Boolean  @default(true)
  modemPreset String   @default("LONG_FAST")
  region      String   @default("EU_433")
  frequency   Float?   // Переопределение частоты в МГц (null = стандартная для региона)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connection  ConnectionConfig?
  presets     Preset[]
}

model Telemetry {
  id            String   @id @default(cuid())
  nodeId        String
  batteryLevel  Int?
  voltage       Float?
  snr           Float
  rssi          Int
  temperature   Float?
  humidity      Float?
  pressure      Float?    // Атмосферное давление (гПа)
  latitude      Float?
  longitude     Float?
  altitude      Float?
  speed         Float?    // GPS ground speed (м/с)
  heading       Float?    // GPS heading (градусы)
  satsInView    Int?      // Количество GPS спутников
  hdop          Float?    // Horizontal Dilution of Precision
  channelUtilization Float? // Загрузка канала %
  airUtilTx     Float?    // Использование эфира TX %
  createdAt     DateTime @default(now())

  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model ConnectionConfig {
  id          String   @id @default(cuid())
  type        String   @default("serial") // serial, mqtt, disabled
  serialPort  String   @default("")
  mqttBroker  String   @default("")
  mqttTopic   String   @default("msh/EU_433/#")
  mqttUsername String  @default("")
  mqttPassword String  @default("")
  channelId   String?  @unique // Привязка к каналу из Channel
  isEnabled   Boolean  @default(false)
  lastSync    DateTime?
  status      String   @default("disconnected") // connected, disconnected, error
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
}

model Preset {
  id          String   @id @default(cuid())
  name        String   // Название пресета (например "Трекер лес 12ч")
  description String?  // Описание
  icon        String   @default("📡") // Emoji-иконка

  // Device
  role        String   @default("TRACKER")
  nodeInfoBroadcastSecs Int @default(900)

  // Power
  powerSaving Boolean  @default(false)
  lsSecs      Int      @default(300)
  minWakeSecs Int      @default(10)

  // GPS
  gpsMode     String   @default("ENABLED")
  gpsUpdateInterval Int @default(30)
  agpsEnabled       Boolean  @default(false)  // AGNSS (требует телефон/интернет)
  gpsAttemptTime    Int      @default(90)     // Секунд ожидания GPS-фикса (в лесу нужно больше)
  positionPrecision  Int @default(32)   // channel module_settings.position_precision: биты точности координат (0-32). 32 = макс. точность (~1м), 0 = не передавать, 13 = ~2.9км (дефолт прошивки Channels.cpp)
  positionFlags      Int @default(299)   // position.position_flags: битовая маска PositionFlags (protobuf). ALT=1, ALT_MSL=2, GEO=4, DOP=8, HVDOP=16, SAT=32, SEQ=64, TS=128, HEADING=256, SPEED=512. 299 = дефолт(811) без SPEED (пеший), 811 = дефолт прошивки, 1023 = все
  positionBroadcastSecs Int @default(300)
  smartBroadcastEnabled Boolean @default(true)
  smartBroadcastMinDist Int @default(100)     // Дефолт прошивки = 100м (0=100м). Было 20м — слишком мало, GPS шум ±10м вызывает ложные вещания
  smartBroadcastMinInterval Int @default(120)  // Минимум 120 сек для леса. Было 60 сек — слишком часто
  fixedPosition Boolean @default(false)  // position.fixed_position: зафиксировать координаты устройства. true = устройство использует последнюю известную позицию без обновления GPS. Для стационарных устройств (база, лагерь). ⚠️ Баг #8403: GPS перезаписывает fixed_position — нужно gps_mode=DISABLED

  // Telemetry
  telemetryInterval Int @default(300)

  // LoRa
  region      String   @default("EU_433")
  modemPreset String   @default("LONG_MODERATE")
  txPower     Int      @default(0)
  hopLimit    Int      @default(5)
  usePreamble Boolean  @default(false)

  // Bluetooth
  bluetoothEnabled Boolean @default(true)
  bluetoothFixedPin String @default("113566") // Фиксированный PIN для сопряжения по BT

  // Display
  screenOnSecs Int @default(60)
  ledDisabled  Boolean @default(true)

  // Network
  rebroadcastMode String @default("ALL")

  // Канал из вкладки Каналы
  channelId   String?  // Ссылка на канал — подтягивает PSK, имя, uplink/downlink, частоту

  // Системный пресет (нельзя удалить)
  isBuiltIn   Boolean  @default(false)
  builtinId   String?  @unique // Стабильный ID для миграции встроенных пресетов (null = пользовательский)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
}

model SyncLog {
  id          String   @id @default(cuid())
  source      String   // serial, mqtt, test
  nodeId      BigInt?
  nodeName    String?
  action      String   // created, updated, synced
  eventType   String?  // battery, position, telemetry, heartbeat, device_info
  details     String?  // JSON: что конкретно пришло/изменилось
  createdAt   DateTime @default(now())
}
